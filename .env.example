DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/fernandaepedro?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/fernandaepedro?sslmode=require
NEXT_PUBLIC_WEDDING_DATE=2026-08-08
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3750.8!2d-43.94!3d-19.96!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zMTnCsDU3JzM2LjAiUyA0M8KwNTYnMjQuMCJX!5e0!3m2!1spt-BR!2sbr!4v1234567890
MERCADO_PAGO_ACCESS_TOKEN=TEST-2077094581531372-022600-ffeb5afc9a86dfd13800d7159caf4366-3367306
# Public key do MP — necessária pro Card Brick inline. Pegar em mercadopago.com.br/developers → suas credenciais
NEXT_PUBLIC_MERCADO_PAGO_PUBLIC_KEY=TEST-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Google Sheets — guest list / RSVP source of truth
# 1. GCP → enable Google Sheets API, create service account, download JSON key
# 2. Share the sheet with the service account email as Editor
# 3. Paste the JSON key as a single line (cat key.json | jq -c .)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@...iam.gserviceaccount.com","client_id":"...","token_uri":"https://oauth2.googleapis.com/token"}
GUEST_SHEET_ID=1AbcDefGhIjKlMnOpQrStUvWxYz0123456789
GUEST_SHEET_TAB_NAME=Convidados
GUEST_SHEET_RANGE=A2:H1000

# Vercel AI Gateway — uma única chave para GPT-5.2 (mensagem) e Gemini-3-Pro-Image (imagem do presente).
# Pegar em vercel.com/dashboard → AI Gateway → API Keys.
AI_GATEWAY_API_KEY=

# Vercel Blob — armazena a imagem decorativa gerada pela IA, vinculada à compra.
# É injetado automaticamente quando o Blob Store está linkado ao projeto na Vercel;
# pra dev local, rode `vercel env pull` ou pegue manualmente em Storage → Blob → Tokens.
BLOB_READ_WRITE_TOKEN=
